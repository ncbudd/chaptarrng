ARG NODE_VERSION=24.22.3
ARG NODE_SHA256=061ec3e3062115705b56b51fa9cc330ab50d34b6969387d4e4b1a50c6809acc2

FROM mcr.microsoft.com/dotnet/sdk:10.0.404-resolute@sha256:f685dd6b5a970778b53cead9a11cf54206c4b4fc3c97e4424a59b8bff9aa43d7
ARG NODE_VERSION
ARG NODE_SHA256
RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y; \
    rm -rf /var/lib/apt/lists/*; \
    curl --fail --location --silent --show-error "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" -o /tmp/node.tar.gz; \
    echo "${NODE_SHA256}  /tmp/node.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/node; \
    tar -xzf /tmp/node.tar.gz -C /tmp/node "node-v${NODE_VERSION}-linux-x64/bin/node"; \
    install -m 0755 "/tmp/node/node-v${NODE_VERSION}-linux-x64/bin/node" /usr/local/bin/node; \
    rm -rf /tmp/node /tmp/node.tar.gz; \
    rm -f /usr/bin/pebble; \
    node --version

ENV HOME=/tmp
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD ["node", "--version"]
CMD ["node"]
