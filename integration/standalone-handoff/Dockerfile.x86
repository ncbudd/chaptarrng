# Run the Linux x86 handoff under a current, scanned amd64 userspace with the
# 32-bit libraries required by the predecessor's .NET 10.0.12 runtime. The
# predecessor crashes with newer glibc releases, so this pins Ubuntu 24.04's
# glibc while still exercising the actual ELF32 candidate and predecessor.
FROM ubuntu:24.04@sha256:77eb101c607d6e3d4f5ad0c8a02c2136c689b98aba1f359e6502ba517e5c57ec
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        python3 bash procps curl ca-certificates \
        libicu74:i386 libssl3t64:i386 libstdc++6:i386 libgcc-s1:i386 \
        zlib1g:i386 libgssapi-krb5-2:i386 libsqlite3-0:i386 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
ENTRYPOINT ["python3", "/repo/packaging/scripts/test-bookshelf-standalone-handoff.py"]
